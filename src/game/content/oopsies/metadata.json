{
  "contentType": "oopsie",
  "version": "1.0.0",
  "idPrefix": "oops_",
  "displayName": "Oopsies",
  "description": "Cheerful silly drawbacks that persist throughout a dungeon run until removed.",
  "idFormat": "oops_<type>",
  "exampleIds": [
    "oops_heavy_blocks",
    "oops_slippery_buttons",
    "oops_too_much_confetti",
    "oops_sugar_crash"
  ],
  "requiredFields": [
    "id",
    "name",
    "rarity",
    "description",
    "effects",
    "enabled"
  ],
  "fields": {
    "id": {
      "type": "string",
      "pattern": "^oops_[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "rarity": {
      "type": "enum",
      "values": ["oopsie"]
    },
    "description": {
      "type": "string"
    },
    "iconKey": {
      "type": "string"
    },
    "effects": {
      "type": "array",
      "itemType": "object"
    },
    "removeCost": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "itemType": "string"
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "dataList": {},
  "defaults": {
    "rarity": "oopsie",
    "enabled": true,
    "effects": [],
    "tags": []
  }
}
