{
  "contentType": "mapNode",
  "version": "1.0.0",
  "idPrefix": "node_",
  "displayName": "Map Nodes",
  "description": "Map tile definitions for different room types and encounters.",
  "idFormat": "node_<type>",
  "exampleIds": [
    "node_start",
    "node_fight",
    "node_event",
    "node_shop",
    "node_elite",
    "node_boss"
  ],
  "requiredFields": [
    "id",
    "name",
    "nodeType",
    "roomScene",
    "enabled"
  ],
  "fields": {
    "id": {
      "type": "string",
      "pattern": "^node_[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "nodeType": {
      "type": "enum",
      "values": ["start", "battle", "event", "shop", "elite", "rest", "treasure", "boss"]
    },
    "description": {
      "type": "string"
    },
    "iconKey": {
      "type": "string"
    },
    "roomScene": {
      "type": "string"
    },
    "effects": {
      "type": "array",
      "itemType": "object"
    },
    "tags": {
      "type": "array",
      "itemType": "string"
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "dataList": {},
  "defaults": {
    "enabled": true,
    "effects": [],
    "tags": []
  }
}
