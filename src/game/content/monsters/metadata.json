  "fields": {
    "id": {
      "type": "string",
      "label": "Monster ID",
      "pattern": "^mon_[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "label": "Name"
    },
    "description": {
      "type": "string",
      "label": "Description"
    },
    "rarity": {
      "type": "enum",
      "label": "Rarity",
      "dataList": "rarity"
    },
    "tier": {
      "type": "enum",
      "label": "Tier",
      "dataList": "tier"
    },
    "role": {
      "type": "enum",
      "label": "Role",
      "dataList": "role"
    },
    "biome": {
      "type": "enum",
      "label": "Biome",
      "dataList": "biome"
    },
    "spriteKey": {
      "type": "string",
      "label": "Sprite Key"
    },
    "stats": {
      "type": "object",
      "label": "Stats",
      "requiredFields": [
        "hp",
        "attack",
        "armor",
        "attackIntervalLocks"
      ],
      "properties": {
        "hp": {
          "type": "number",
          "min": 1
        },
        "attack": {
          "type": "number",
          "min": 0
        },
        "armor": {
          "type": "number",
          "min": 0
        },
        "attackIntervalLocks": {
          "type": "number",
          "min": 1
        }
      }
    },
    "intent": {
      "type": "object",
      "label": "Intent",
      "requiredFields": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "type": "enum",
          "dataList": "intentIds"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "behaviors": {
      "type": "array",
      "label": "Behaviors",
      "itemType": "enum",
      "dataList": "behaviors",
      "uniqueItems": true
    },
    "resistances": {
      "type": "array",
      "label": "Resistances",
      "itemType": "enum",
      "dataList": "resistances",
      "uniqueItems": true
    },
    "weaknesses": {
      "type": "array",
      "label": "Weaknesses",
      "itemType": "enum",
      "dataList": "weaknesses",
      "uniqueItems": true
    },
    "scaling": {
      "type": "object",
      "label": "Scaling",
      "properties": {
        "hpPerStage": {
          "type": "number"
        },
        "attackPerStage": {
          "type": "number"
        },
        "fallSpeedModifier": {
          "type": "number"
        }
      }
    },
    "rewards": {
      "type": "object",
      "label": "Rewards",
      "requiredFields": [
        "goldMin",
        "goldMax",
        "rewardRolls",
        "lootTableId"
      ],
      "properties": {
        "goldMin": {
          "type": "number",
          "min": 0
        },
        "goldMax": {
          "type": "number",
          "min": 0
        },
        "rewardRolls": {
          "type": "number",
          "min": 0
        },
        "lootTableId": {
          "type": "enum",
          "dataList": "rewardLootTables"
        }
      }
    },
    "tags": {
      "type": "array",
      "label": "Tags",
      "itemType": "enum",
      "dataList": "tags",
      "uniqueItems": true
    },
    "enabled": {
      "type": "boolean",
      "label": "Enabled"
    },
    "stageId": {
      "type": "enum",
      "label": "Stage ID",
      "dataList": "stageIds"
    },
    "rank": {
      "type": "enum",
      "label": "Wiki Rank",
      "dataList": "rank"
    },
    "encounterRank": {
      "type": "enum",
      "label": "Encounter Rank",
      "dataList": "encounterRank"
    },
    "iconKey": {
      "type": "string",
      "label": "Icon Key"
    },
    "assetRefs": {
      "type": "object",
