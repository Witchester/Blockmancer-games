{
  "contentType": "monster",
  "version": "1.0.0",
  "idPrefix": "mon_",
  "displayName": "Monsters",
  "description": "Schema metadata for enemy units, encounter behaviors, combat scaling, and reward hooks.",
  "idFormat": "mon_<biome_or_family>_<name>",
  "exampleIds": [
    "mon_cupcake_slime",
    "mon_wrench_goblin",
    "mon_ice_cream_imp",
    "mon_button_knight",
