{
  "contentType": "encounterPackScaling",
  "version": "1.0.0",
  "idPrefix": "scale_encounter_",
  "displayName": "Encounter Pack Scaling Rules",
  "description": "Rules for generating sequential enemy encounter packs per node type and stage.",
  "idFormat": "scale_encounter_<stage>_<nodeType>",
  "exampleIds": [
    "scale_encounter_stage1_normal",
    "scale_encounter_stage2_elite",
    "scale_encounter_stage6_boss"
  ],
  "requiredFields": [
    "id",
    "stageNumber",
    "stageId",
    "nodeType",
    "minEnemies",
    "maxEnemies",
    "totalHpBudgetMultiplierRange",
    "totalAttackBudgetMultiplierRange",
    "entryGracePieces",
    "maxActiveHazards"
  ],
  "fields": {
    "id": {
      "type": "string",
      "pattern": "^scale_encounter_[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "stageNumber": {
      "type": "number",
      "min": 1,
      "max": 6
    },
    "stageId": {
      "type": "string"
    },
    "nodeType": {
      "type": "enum",
      "values": ["normal", "elite", "boss", "event_battle", "royal_guard"]
    },
    "minEnemies": {
      "type": "number",
      "min": 1,
      "max": 5
    },
    "maxEnemies": {
      "type": "number",
      "min": 1,
      "max": 5
    },
    "earlyNodeEnemyCap": {
      "type": "number",
      "min": 1,
      "max": 5,
      "optional": true
    },
    "lateNodeEnemyCap": {
      "type": "number",
      "min": 1,
      "max": 5,
      "optional": true
    },
    "totalHpBudgetMultiplierRange": {
      "type": "array",
      "itemType": "number",
      "minItems": 2,
      "maxItems": 2
    },
    "totalAttackBudgetMultiplierRange": {
      "type": "array",
      "itemType": "number",
      "minItems": 2,
      "maxItems": 2
    },
    "entryGracePieces": {
      "type": "number",
      "min": 0
    },
    "maxActiveHazards": {
      "type": "number",
      "min": 1,
      "max": 3
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "dataList": {
    "nodeTypes": [
      "normal",
      "elite",
      "boss",
      "event_battle",
      "royal_guard"
    ],
    "stages": [
      "stage_1",
      "stage_2",
      "stage_3",
      "stage_4",
      "stage_5",
      "stage_6"
    ]
  },
  "defaults": {
    "minEnemies": 1,
    "maxEnemies": 1,
    "totalHpBudgetMultiplierRange": [1.0, 1.0],
    "totalAttackBudgetMultiplierRange": [1.0, 1.0],
    "entryGracePieces": 3,
    "maxActiveHazards": 2,
    "enabled": true
  }
}
