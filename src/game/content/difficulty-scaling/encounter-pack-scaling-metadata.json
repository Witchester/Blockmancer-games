{
  "contentType": "encounterPackScaling",
  "version": "1.0.0",
  "idPrefix": "scale_encounter_",
  "displayName": "Encounter Pack Scaling Rules",
  "description": "Defines how encounter packs scale per stage and node type, including enemy count, HP/attack budgets, and hazard limits.",
  "idFormat": "scale_encounter_<stage>_<nodeType>",
  "exampleIds": [
    "scale_encounter_stage1_normal",
    "scale_encounter_stage1_elite",
    "scale_encounter_stage1_boss"
  ],
  "requiredFields": [
    "id",
    "stageNumber",
    "stageId",
    "nodeType",
    "minEnemies",
    "maxEnemies",
    "totalHpBudgetMultiplierRange",
    "totalAttackBudgetMultiplierRange",
    "entryGracePieces",
    "maxActiveHazards"
  ],
  "fields": {
    "id": {
      "type": "string",
      "pattern": "^scale_encounter_[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "stageNumber": {
      "type": "number",
      "min": 1,
      "max": 6
    },
    "stageId": {
      "type": "string"
    },
    "nodeType": {
      "type": "string",
      "enum": ["normal", "hard_normal", "elite", "boss", "event_battle", "mini_boss", "royal_guard"]
    },
    "minEnemies": {
      "type": "number",
      "min": 1
    },
    "maxEnemies": {
      "type": "number",
      "min": 1
    },
    "earlyNodeEnemyCap": {
      "type": "number"
    },
    "lateNodeEnemyCap": {
      "type": "number"
    },
    "totalHpBudgetMultiplierRange": {
      "type": "array",
      "items": {"type": "number"}
    },
    "totalAttackBudgetMultiplierRange": {
      "type": "array",
      "items": {"type": "number"}
    },
    "entryGracePieces": {
      "type": "number",
      "min": 0
    },
    "maxActiveHazards": {
      "type": "number",
      "min": 1
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "dataList": {
    "stages": [
      "stage_sprinkle_sewers",
      "stage_frosty_pantry",
      "stage_goblin_workshop",
      "stage_pillow_castle",
      "stage_starfall_arcade",
      "stage_bloxley_block_palace"
    ],
    "nodeTypes": [
      "normal",
      "hard_normal",
      "elite",
      "boss",
      "event_battle",
      "mini_boss",
      "royal_guard"
    ]
  },
  "defaults": {
    "minEnemies": 1,
    "maxEnemies": 1,
    "entryGracePieces": 3,
    "maxActiveHazards": 1,
    "enabled": true
  }
}
